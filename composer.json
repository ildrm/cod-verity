{
  "name": "codverity/order-verification-for-woocommerce",
  "description": "Cash on delivery order verification for WooCommerce",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {"php": ">=8.2"},
  "require-dev": {"phpunit/phpunit": "^11.5", "squizlabs/php_codesniffer": "^3.13", "phpstan/phpstan": "^2.1"},
  "scripts": {
    "test": "phpunit",
    "lint": "php tools/lint.php",
    "cs": "phpcs",
    "analyse": "phpstan analyse --memory-limit=512M",
    "package": "php tools/package.php"
  },
  "config": {"sort-packages": true, "allow-plugins": false}
}
